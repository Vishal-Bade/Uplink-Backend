# ==========================================
# Autonomous Research Workspace Configuration
# ==========================================

# Database Configuration (PostgreSQL / Supabase / RDS)
DB_URL=jdbc:postgresql://localhost:5432/cc
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# GenAI & LLM Configuration (OpenAI / Gemini / Groq / Ollama / Mock)
# Set to 'mock' for local offline testing, or 'auto' to auto-detect API keys
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_or_gemini_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60

# Search Provider Configuration (Tavily / DuckDuckGo / SemanticScholar / Mock)
# Set TAVILY_API_KEY to use Tavily. If empty, live DuckDuckGo HTML and Semantic Scholar are used automatically.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=your_tavily_api_key_optional

# Artifacts Storage Directory
ARTIFACTS_STORAGE_DIR=target/artifacts
